er"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="2600" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="7EEED110" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>สังกัด</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6400" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="2AD75783" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00A364A0"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr></w:p></w:tc></w:tr><w:tr w:rsidR="00A364A0" w14:paraId="10047B4F" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="2600" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="4DAE6053" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>จังหวัดหรือพื้นที่รับผิดชอบ</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6400" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="35B230BC" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00A364A0"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr></w:p></w:tc></w:tr><w:tr w:rsidR="00A364A0" w14:paraId="08F98047" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="2600" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="16FB4577" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>ประเด็นเน้นย้ำ 5+1 ที่เกี่ยวข้อง</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6400" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="40A4AFCF" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00A364A0"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr></w:p></w:tc></w:tr><w:tr w:rsidR="00A364A0" w14:paraId="4D05CC52" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="2600" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="66BAE2BB" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>วันที่ปรับปรุงล่าสุด</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6400" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="2A990FF4" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00A364A0"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="727C46F8" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00A364A0"><w:pPr><w:spacing w:after="40" w:line="252" w:lineRule="auto"/></w:pPr></w:p><w:p w14:paraId="24BB887D" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="80" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:color w:val="505050"/><w:sz w:val="28"/></w:rPr><w:t>หมายเหตุ: แบบฟอร์มนี้เป็นเครื่องมือสำหรับใช้ระหว่าง Workshop และสามารถปรับปรุงข้อมูลได้ตลอดกระบวนการพัฒนาโครงการ</w:t></w:r></w:p><w:p w14:paraId="496FE892" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:r><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="6539F59D" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:before="140" w:after="80"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="TH Sarabun New" w:eastAsia="TH Sarabun New" w:hAnsi="TH Sarabun New" w:cs="TH Sarabun New"/></w:rPr><w:lastRenderedPageBreak/><w:t>คำแนะนำการใช้แบบฟอร์ม</w:t></w:r></w:p><w:p w14:paraId="7B907A4C" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="40" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>• ไม่จำเป็นต้องกรอกเอกสารให้เสร็จในครั้งเดียว ให้เติมข้อมูลตามผลที่ได้จาก Workshop แต่ละวัน</w:t></w:r></w:p><w:p w14:paraId="70B0B5E2" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="40" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>• สามารถกลับมาแก้ไขข้อมูลได้เมื่อได้รับ Feedback หรือมีหลักฐานใหม่</w:t></w:r></w:p><w:p w14:paraId="463E9E1B" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="40" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>• คำตอบควรสั้น ชัดเจน เป็นประเด็น และมีหลักฐานสนับสนุนเท่าที่มี</w:t></w:r></w:p><w:p w14:paraId="6B444726" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="40" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>• ให้เน้นปัญหาจริง กลุ่มเป้าหมาย กระบวนการทำงาน ข้อมูล เทคโนโลยี ความเป็นไปได้ และการนำไปทดลองใช้จริง</w:t></w:r></w:p><w:p w14:paraId="356A78BD" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="40" w:line="252" w:lineRule="auto"/></w:pPr><w:r><w:t>• เป้าหมายสุดท้ายคือใช้เอกสารนี้หารือกับผู้บังคับบัญชาและเริ่มต้นการนำโครงการไปทดลองในพื้นที่หรือหน่วยงาน</w:t></w:r></w:p><w:p w14:paraId="50A6AEEB" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="80" w:after="80"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="TH Sarabun New" w:eastAsia="TH Sarabun New" w:hAnsi="TH Sarabun New" w:cs="TH Sarabun New"/></w:rPr><w:t>แนวคิดการกรอกแบบฟอร์ม</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:w="9000" w:type="dxa"/><w:jc w:val="center"/><w:tblBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="A6A6A6"/><w:left w:val="single" w:sz="4" w:space="0" w:color="A6A6A6"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="A6A6A6"/><w:right w:val="single" w:sz="4" w:space="0" w:color="A6A6A6"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="A6A6A6"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="A6A6A6"/></w:tblBorders><w:tblLayout w:type="fixed"/><w:tblLook w:val="04A0" w:firstRow="1" w:lastRow="0" w:firstColumn="1" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="2600"/><w:gridCol w:w="6400"/></w:tblGrid><w:tr w:rsidR="00A364A0" w14:paraId="7298D7B3" w14:textId="77777777"><w:trPr><w:tblHeader/><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="2600" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="EAF2F8"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="2591596B" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="30"/></w:rPr><w:t>ลำดับความคิด</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6400" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="EAF2F8"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="542034DD" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="30"/></w:rPr><w:t>สิ่งที่ต้องกรอกแบบสั้น</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00A364A0" w14:paraId="2AEEEC36" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="2600" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="6C97F0ED" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:sz w:val="30"/></w:rPr><w:t>1. ปัญหาจริง</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6400" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="1C029A87" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:sz w:val="30"/></w:rPr><w:t>ระบุปัญหา หลักฐาน และผลกระทบที่เกิดขึ้น</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00A364A0" w14:paraId="185F65D5" w14:textId="