w:tcW w:w="6400" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="7D8F3887" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:sz w:val="30"/></w:rPr><w:t>ระบุข้อมูล เครื่องมือดิจิทัล หรือ AI ที่จำเป็น</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00A364A0" w14:paraId="22721889" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="2600" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="7CFDDD7E" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:sz w:val="30"/></w:rPr><w:t>5. ทดลองและขยายผล</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6400" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="322722E2" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="20" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:sz w:val="30"/></w:rPr><w:t>กำหนดต้นแบบ การทดลอง แผน 1 ปี ตัวชี้วัด และเงื่อนไขขยายผล</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="0E2410D8" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00A364A0"><w:pPr><w:spacing w:after="40" w:line="252" w:lineRule="auto"/></w:pPr></w:p><w:p w14:paraId="18A6F67A" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:r><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="584A6F26" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:before="140" w:after="80"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="TH Sarabun New" w:eastAsia="TH Sarabun New" w:hAnsi="TH Sarabun New" w:cs="TH Sarabun New"/></w:rPr><w:lastRenderedPageBreak/><w:t>หน้าสรุปความก้าวหน้า</w:t></w:r></w:p><w:p w14:paraId="3A96F3ED" w14:textId="77777777" w:rsidR="00A364A0" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="80" w:line="252" w:lin